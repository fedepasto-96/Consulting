# ─── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Office / temp working files ──────────────────────
~$*
*.tmp
*.bak
*.~*

# ─── Editors / IDEs ───────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Python (tools/) ──────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─── Secrets / environment ────────────────────────────
.env
.env.*
*.key
*.pem
credentials.json

# ─── Large / generated outputs ────────────────────────
# Keep rendered deliverables out of git unless explicitly needed.
# Comment these out per-project if you want to version the PDFs.
*.pdf.tmp
/tmp/
*.log

# ─── OpenClaw / agent workspace ───────────────────────
# Workspace files (AGENTS.md, SOUL.md, IDENTITY.md, USER.md, etc.) ARE tracked.
# The agent's private memory and local settings stay local only.
memory/
.claude/settings.local.json
.aider*
